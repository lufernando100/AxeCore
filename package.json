{
  "name": "axe-automation",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "axe": "node ./src/run-axe.js --config axe.config.json",
    "axe:all": "node ./src/run-axe.js --input ./test-urls.txt --output ./reports/all-results.json --browser firefox --timeout 60000 --perUrlDir ./reports/per-url --aggregateDir ./reports/aggregate && npm run jira:sync",
    "axe:default": "node ./src/run-axe.js --config axe.config.json --input ./test-urls.txt",
    "preview-config": "node ./scripts/preview-config.js --config axe.config.json",
    "axe:learn": "node ./src/run-axe.js --config axe.config.json --input ./test-urls.txt --bestPracticeMode learn",
    "axe:no-best": "node ./src/run-axe.js --config axe.config.json --input ./test-urls.txt --bestPracticeMode off",
    "axe:report": "node ./scripts/regenerate-reports.js",
    "jira:sync": "node ./src/jira-sync.js",
    "save:baseline": "node ./src/save-baseline.js",
    "check:regression": "node ./src/regression-check.js",
    "axe:regression": "npm run axe:all && npm run check:regression"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@axe-core/playwright": "^4.11.0",
    "axe-core": "^4.11.0",
    "axios": "^1.13.2",
    "csv-parse": "^5.4.0",
    "dotenv": "^17.2.3",
    "jira-client": "^8.2.2",
    "jsdom": "^22.1.0",
    "playwright": "^1.56.1",
    "yargs": "^17.7.2"
  }
}
